{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "JwtSettings:Key",
    "Issuer": "JwtPennySaverApi",
    "Audience": "JwtPennySaverReact",
    "DurationInMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "ConnectionString:DefaultConnection"
  },
  "Plaid": {
    "Environment": "sandbox",
    "ClientId": "Plaid:ClientId",
    "Secret": "Plaid:Secret",
    "Enabled": true
  }
}