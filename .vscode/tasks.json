{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/PennySaver.API/PennySaver.API.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-client",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/PennySaver-Client" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-tests",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/PennySaver.Tests/PennySaver.Tests.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-all",
      "dependsOn": ["build-api", "build-client", "build-tests"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev-client",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/PennySaver-Client" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "test-dotnet",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/PennySaver.Tests/PennySaver.Tests.csproj"],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}